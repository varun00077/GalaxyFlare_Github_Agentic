# --- LLM (Google Gemini) ---------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini model with function calling. Flash is fast and cheap for the loop.
GEMINI_MODEL=gemini-3.6-flash

# --- Groq (OpenAI-compatible, fast, generous free tier) ----------------------
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# "auto" picks the strongest tool-capable model your key can use (openai/gpt-oss-120b first)
GROQ_MODEL=auto

# --- Planner -----------------------------------------------------------------
# groq    -> Groq planner (needs GROQ_API_KEY)            <- recommended for live demos
# gemini  -> Gemini planner (needs GEMINI_API_KEY; free tier rate-limits hard)
# mock    -> deterministic scripted planner; runs offline, used by tests/eval
LLM_PROVIDER=groq
# Max planner steps per incident before the agent escalates instead of guessing.
STEP_BUDGET=24

# --- Environment -------------------------------------------------------------
# sandbox -> synthetic scenarios s1..s6 (default)   live -> this Windows host (see README "Live host mode")
ENVIRONMENT=sandbox
# Live mode knobs: real firewall rules need an elevated process AND LIVE_ACTIONS=1
LIVE_ACTIONS=0
LIVE_WINDOW_HOURS=24
LIVE_BRUTE_THRESHOLD=5
# Optional: path to a real Suricata eve.json to import alerts from
LIVE_EVE_JSON=
# Optional keys: NVD_API_KEY (higher NVD rate limit), ABUSEIPDB_KEY (IP reputation)
NVD_API_KEY=
ABUSEIPDB_KEY=

# --- Sandbox (the simulated enterprise environment) -------------------------
# URL of the sandbox service. Leave empty to run it in-process (CLI/tests).
SANDBOX_URL=http://localhost:8001
# Scenario the sandbox loads on start (s1..s6)
SCENARIO=s2

# --- Storage -----------------------------------------------------------------
INCIDENT_DB=data/incidents.db
